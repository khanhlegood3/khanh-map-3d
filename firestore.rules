rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isValidUserInfo(data) {
      return data.keys().hasAll(['referralCode', 'totalReferredUsers', 'earnedRewards']) &&
             data.referralCode is string && data.referralCode.size() <= 50 &&
             data.totalReferredUsers is number &&
             data.earnedRewards is number &&
             ( !('emailAlertsEnabled' in data) || data.emailAlertsEnabled is bool ) &&
             ( !('alertEmail' in data) || (data.alertEmail is string && data.alertEmail.size() <= 100) );
    }

    function isValidReferredUser(data) {
      return data.keys().hasAll(['username', 'joinDate', 'reward', 'status']) &&
             data.username is string && data.username.size() <= 100 &&
             data.joinDate is string && data.joinDate.size() <= 100 &&
             data.reward is number &&
             data.status in ["Active", "Pending", "Completed"] &&
             ( !('milestone' in data) || (data.milestone is string && data.milestone.size() <= 200) ) &&
             ( !('locationName' in data) || (data.locationName is string && data.locationName.size() <= 200) ) &&
             ( !('latitude' in data) || data.latitude is number ) &&
             ( !('longitude' in data) || data.longitude is number );
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserInfo(incoming()) && incoming().keys().size() <= 5;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUserInfo(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['referralCode', 'totalReferredUsers', 'earnedRewards', 'emailAlertsEnabled', 'alertEmail']);
    }

    match /users/{userId}/referred_users/{referredUserId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(referredUserId) && isValidReferredUser(incoming()) && incoming().keys().size() <= 8;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidReferredUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'joinDate', 'reward', 'status', 'milestone', 'locationName', 'latitude', 'longitude']);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
